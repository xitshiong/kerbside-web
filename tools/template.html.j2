<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ name }}: {{ tagline }}</title>
<meta name="description" content="{{ intro }}">
<meta name="theme-color" content="{{ color }}">
<meta property="og:title" content="{{ name }}: {{ tagline }}">
<meta property="og:description" content="{{ intro }}">
<meta property="og:type" content="website">
{% if hero %}<meta property="og:image" content="img/{{ hero.id }}-1600.jpg">{% endif %}
{% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ font|replace(' ','+') }}:wght@{{ font_weights }}&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">
{% if hero %}<link rel="preload" as="image" href="img/{{ hero.id }}-1600.jpg" imagesrcset="img/{{ hero.id }}-800.jpg 800w, img/{{ hero.id }}-1600.jpg 1600w" imagesizes="(max-width: 1180px) 100vw, 1100px">{% endif %}
<style>
/* Hallmark · v2.0.0 · redesign: rework · theme: custom per trade (spec font, colour, paper, radius) · job: call, book or enquire, action in hero and fixed bar · hero: plain headline over a wide photograph · nav: name, links, phone · footer: row with credits */
/* Hallmark · pre-emit critique · weakest: stand-in photos until the client sends their own */
:root{--on:#fffdf8;--field:#fffefb;--c:{{ color }};--c2:{{ accent }};--paper:{{ paper }};--ink:#17181c;--muted:#565a63;--line:color-mix(in srgb,var(--ink) 14%,transparent);--tint:color-mix(in srgb,var(--c) 7%,var(--paper));--display:"{{ font }}",Georgia,serif;--r:{{ radius }};--ir:{{ img_radius }};--ease:cubic-bezier(.2,.7,.2,1)}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;overflow-x:clip}
body{margin:0;font:400 17px/1.6 "DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--paper);padding-bottom:76px;overflow-x:clip;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-underline-offset:3px}
:focus-visible{outline:3px solid var(--c);outline-offset:3px;border-radius:4px}
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}
.banner{border-bottom:1px solid var(--line);color:var(--muted);font-size:13px;text-align:center;padding:8px 16px}
.banner a{color:var(--ink);font-weight:500}
.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:var(--field);padding:8px 12px;z-index:20}
.top{position:sticky;top:0;z-index:8;background:var(--paper);border-bottom:1px solid var(--line)}
header{display:flex;align-items:center;gap:32px;min-height:68px}
.brand{font-family:var(--display);font-weight:{{ heading_weight }};font-size:22px;letter-spacing:-.01em;text-decoration:none;line-height:1.1;margin-right:auto}
.brand span{color:inherit}
header nav{display:flex;gap:28px;font-size:15px}
header nav a{text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .25s var(--ease)}
header nav a:hover{background-size:100% 1px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;background:var(--c);color:var(--on);text-decoration:none;padding:12px 24px;border-radius:var(--r);font:500 16px/1.2 inherit;font-family:inherit;border:0;cursor:pointer;transition:transform .16s var(--ease),background-color .16s ease}
.btn:hover{background:var(--c2)}.btn:active{transform:translateY(1px)}.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.sm{min-height:40px;padding:8px 16px;font-size:15px}
.tlink{display:inline-flex;align-items:center;min-height:48px;font-weight:500;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
.tlink:hover{text-decoration-thickness:2px}
h1,h2,h3{font-family:var(--display);font-weight:{{ heading_weight }};letter-spacing:-.02em;line-height:1.06;margin:0;overflow-wrap:break-word;min-width:0}
h1{font-size:clamp(40px,5.6vw,72px);text-wrap:balance;max-width:14ch}
h2{font-size:clamp(30px,3.4vw,44px);margin-bottom:24px;text-wrap:balance}
.hero{padding:clamp(32px,5vw,64px) 0 clamp(24px,3vw,40px);display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:24px clamp(24px,5vw,72px);align-items:end}
.lead{font-size:clamp(17px,1.4vw,19px);color:var(--muted);margin:0 0 24px;max-width:42ch}
.ctas{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px}
.shot{margin:0;border-radius:var(--ir);overflow:hidden;aspect-ratio:21/9;background:var(--line)}
.shot img,.ph img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}
.ph{margin:0;border-radius:var(--ir);overflow:hidden;background:var(--line)}
@media(hover:hover){.ph:hover img{transform:scale(1.025)}}
.info{list-style:none;margin:0;padding:28px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px clamp(24px,5vw,72px);border-bottom:1px solid var(--line)}
.info li{display:grid;gap:2px;align-content:start}
.info b{font-weight:500}
.info span,.info a{color:var(--muted)}
section{padding:clamp(56px,8vw,104px) 0}
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,88px);align-items:start}
.list{list-style:none;margin:0;padding:0}
.list li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 20px;padding:16px 0;border-bottom:1px solid var(--line)}
.list li:first-child{padding-top:0}
.list h3{font-size:clamp(19px,1.7vw,22px)}
.list .price{font-weight:500;white-space:nowrap;align-self:baseline;font-variant-numeric:tabular-nums}
.list p{grid-column:1/-1;margin:0;color:var(--muted);max-width:56ch}
.note{color:var(--muted);margin:-8px 0 28px;max-width:46ch}
.side{position:sticky;top:96px;aspect-ratio:4/5}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.grid3 .ph{aspect-ratio:1}
.grid3.n2{grid-template-columns:repeat(2,minmax(0,1fr))}.grid3.n1{grid-template-columns:minmax(0,1fr)}.grid3.n1 .ph{aspect-ratio:21/9}
.about{background:var(--tint)}
.about .split{align-items:center}
.about p{font-size:clamp(18px,1.6vw,21px);line-height:1.55;margin:0;max-width:46ch}
.about .ph{aspect-ratio:4/3}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
td{padding:12px 0;border-bottom:1px solid var(--line)}td:last-child{text-align:right}
.addr{margin:24px 0 0;font-weight:500}
.area{color:var(--muted);margin:0 0 20px;max-width:46ch}
iframe.map{width:100%;height:100%;min-height:360px;border:0;border-radius:var(--ir);filter:grayscale(.5)}
.venue #visit{background:var(--c2);color:var(--on)}
.venue #visit .area,.venue #visit td{color:var(--on);border-color:color-mix(in srgb,var(--on) 22%,transparent)}
form{display:grid;gap:16px}
label{display:grid;gap:8px;font-weight:500;font-size:15px}
input,textarea{font:inherit;padding:12px 16px;border-radius:var(--r);border:1px solid color-mix(in srgb,var(--ink) 28%,transparent);width:100%;background:var(--field);color:var(--ink)}
input:focus,textarea:focus{outline:3px solid color-mix(in srgb,var(--c) 40%,transparent);border-color:var(--c)}
.direct{display:grid;gap:12px;align-content:start}
.direct a.big{font-family:var(--display);font-size:clamp(28px,3.2vw,40px);font-weight:{{ heading_weight }};text-decoration:none;line-height:1.1}
.direct p{margin:0}.muted{color:var(--muted)}
footer{padding:32px 0 40px;font-size:14px;color:var(--muted);border-top:1px solid var(--line)}
footer .row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px}
.credits{margin-top:16px;font-size:12px}.credits a{color:inherit}
.bar{position:fixed;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px 12px calc(12px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid var(--line);z-index:9}
.bar .btn.alt{background:var(--field);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line)}
@media(min-width:821px){.bar{display:none}body{padding-bottom:0}}
@media(max-width:820px){
 header nav{display:none}
 .hero,.split{grid-template-columns:minmax(0,1fr)}
 .shot{aspect-ratio:4/3;margin:0 calc(-1*clamp(20px,4vw,40px));border-radius:0}
 .info{grid-template-columns:minmax(0,1fr)}
 .side{position:static;aspect-ratio:4/3}
 .grid3{grid-template-columns:repeat(2,minmax(0,1fr))}.grid3 .ph:nth-child(3){display:none}
 iframe.map{min-height:280px}
}
@media(max-width:420px){header .btn{display:none}}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:no-preference){
 .hero h1,.hero .lead,.hero .ctas{animation:rise .7s var(--ease) both}
 .hero .lead{animation-delay:.08s}.hero .ctas{animation-delay:.16s}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn,.shot img,.ph img,header nav a{transition:none}}
</style>
</head>
<body{% if layout %} class="{{ layout }}"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
{% if banner %}<div class="banner">{{ banner|safe }}</div>{% endif %}
<div class="top"><div class="wrap">
<header>
 <a class="brand" href="#top" aria-label="{{ name }} home">{{ name_html|safe }}</a>
 <nav aria-label="Main">{% if services %}<a href="#services">{{ services_title }}</a>{% endif %}{% if about %}<a href="#about">{{ about_title }}</a>{% endif %}<a href="#visit">{{ area_title }}</a><a href="#contact">Contact</a></nav>
 {% if phone %}<a class="btn sm" href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a>{% else %}<a class="btn sm" href="#contact">{{ bar_cta or "Enquire" }}</a>{% endif %}
</header>
</div></div>
<main id="main">
<div class="wrap" id="top">
 <div class="hero">
  <h1>{{ headline }}</h1>
  <div>
   <p class="lead">{{ intro }}</p>
   <div class="ctas">
    {% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">{{ cta_primary }}</a>{% endif %}
    <a class="{% if phone %}tlink{% else %}btn{% endif %}" href="#contact">{{ cta_secondary }}</a>
   </div>
  </div>
 </div>
 {% if hero %}<figure class="shot"><img src="img/{{ hero.id }}-1600.jpg" srcset="img/{{ hero.id }}-800.jpg 800w, img/{{ hero.id }}-1600.jpg 1600w" sizes="(max-width: 1180px) 100vw, 1100px" width="{{ hero.w }}" height="{{ hero.h }}" alt="{{ hero.alt }}"{% if hero.pos %} style="object-position:{{ hero.pos }}"{% endif %} fetchpriority="high" decoding="async"></figure>{% endif %}
 <ul class="info" aria-label="At a glance">
  <li><b>{{ tagline }}</b>{% if address %}<a href="#visit">{{ address }}</a>{% elif area %}<span>{{ area }}</span>{% endif %}</li>
  {% if hours %}<li><b>Hours</b><span>{% for h in hours[:2] %}{{ h[0] }} {{ h[1] }}{% if not loop.last %}<br>{% endif %}{% endfor %}</span>{% if hours|length > 2 %}<a href="#visit">All opening hours</a>{% endif %}</li>{% endif %}
  {% if phone %}<li><b>Call</b><a href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a></li>{% elif email %}<li><b>Email</b><a href="mailto:{{ email }}">{{ email }}</a></li>{% endif %}
 </ul>
</div>

{% if services %}<section id="services">
 <div class="wrap split">
  <div>
   <h2>{{ services_title }}</h2>{% if services_note %}<p class="note">{{ services_note }}</p>{% endif %}
   <ul class="list">
   {% for s in services %}<li><h3>{{ s.name }}</h3>{% if s.price %}<span class="price">{{ s.price }}</span>{% endif %}{% if s.desc %}<p>{{ s.desc }}</p>{% endif %}</li>{% endfor %}
   </ul>
  </div>
  {% if gallery %}<figure class="ph side"><img src="img/{{ gallery[0].id }}-800.jpg" srcset="img/{{ gallery[0].id }}-800.jpg 800w, img/{{ gallery[0].id }}-1600.jpg 1600w" sizes="(max-width: 820px) 100vw, 540px" width="{{ gallery[0].w }}" height="{{ gallery[0].h }}" alt="{{ gallery[0].alt }}" loading="lazy" decoding="async"></figure>{% endif %}
 </div>
</section>{% endif %}

{% if gallery and gallery|length > 1 %}<div class="wrap"><div class="grid3 n{{ gallery[1:4]|length }}">{% for g in gallery[1:4] %}<figure class="ph"><img src="img/{{ g.id }}-800.jpg" width="{{ g.w }}" height="{{ g.h }}" alt="{{ g.alt }}" loading="lazy" decoding="async"></figure>{% endfor %}</div></div>{% endif %}

{% if about %}
<section id="about" class="about">
 <div class="wrap split">
  {% if about_img %}<figure class="ph"><img src="img/{{ about_img.id }}-800.jpg" srcset="img/{{ about_img.id }}-800.jpg 800w, img/{{ about_img.id }}-1600.jpg 1600w" sizes="(max-width: 820px) 100vw, 540px" width="{{ about_img.w }}" height="{{ about_img.h }}" alt="{{ about_img.alt }}" loading="lazy" decoding="async"></figure>{% endif %}
  <div><h2>{{ about_title }}</h2><p>{{ about }}</p></div>
 </div>
</section>
{% endif %}
{% if rating and maps_url %}
<div class="wrap"><p class="area"><a href="{{ maps_url }}">Rated {{ rating }} from {{ review_count }} Google reviews</a></p></div>
{% endif %}

<section id="visit">
 <div class="wrap split">
  <div>
   <h2>{{ area_title }}</h2>
   {% if area %}<p class="area">{{ area }}</p>{% endif %}
   {% if hours %}<table><caption class="skip">Opening hours</caption>{% for h in hours %}<tr><td>{{ h[0] }}</td><td>{{ h[1] }}</td></tr>{% endfor %}</table>{% endif %}
   {% if address %}<p class="addr">{{ address }}</p>{% endif %}
  </div>
  {% if map_query %}<iframe class="map" loading="lazy" src="https://maps.google.com/maps?q={{ map_query|urlencode }}&output=embed" title="Map of {{ map_query }}"></iframe>{% endif %}
 </div>
</section>

<section id="contact" class="contact">
 <div class="wrap split">
  <div class="direct">
   <h2>{{ contact_title }}</h2>
   {% if phone %}<a class="big" href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a>{% endif %}
   {% if email %}<p><a href="mailto:{{ email }}">{{ email }}</a></p>{% endif %}
   {% for l in links %}<p><a href="{{ l[1] }}">{{ l[0] }}</a></p>{% endfor %}
   {% if licence %}<p class="muted">{{ licence }}</p>{% endif %}
  </div>
  <form data-email="{{ email }}" onsubmit="event.preventDefault();var f=this;location.href='mailto:'+f.dataset.email+'?subject='+encodeURIComponent('Enquiry from website')+'&body='+encodeURIComponent('Name: '+f.n.value+'\nPhone: '+f.p.value+'\n\n'+f.m.value);">
   <label>Your name<input name="n" autocomplete="name" required></label>
   <label>Phone<input name="p" type="tel" autocomplete="tel" inputmode="tel" required></label>
   <label>{{ form_label }}<textarea name="m" rows="4" placeholder="{{ form_placeholder }}"></textarea></label>
   <button class="btn" type="submit">Send enquiry</button>
  </form>
 </div>
</section>
</main>
<footer class="wrap">
 <div class="row"><span>© {{ year }} {{ name }}{% if abn %}, ABN {{ abn }}{% endif %}</span>{% if credit %}<span>Website by <a href="{{ credit }}">Kerbside Web</a></span>{% endif %}</div>
 {% if photo_credits %}<p class="credits">Photos: {% for p in photo_credits %}<a href="{{ p.page }}">{{ p.by }}</a> (<a href="{{ p.licenceUrl }}">{{ p.licence }}</a>){% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
</footer>
<div class="bar">{% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">Call</a>{% endif %}<a class="btn alt" href="#contact">{{ bar_cta or cta_secondary }}</a></div>
</body></html>
