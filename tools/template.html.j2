<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ name }} — {{ tagline }}</title>
<meta name="description" content="{{ intro }}">
{% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}
<style>
:root{--c:{{ color }};--c2:{{ accent }};--ink:#1b1f27;--muted:#5f6673;--bg:#fafaf8;--line:#e8e6e1}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6;padding-bottom:72px}
a{color:inherit}.wrap{max-width:980px;margin:0 auto;padding:0 20px}
.banner{background:#111;color:#fff;font-size:13px;text-align:center;padding:8px 12px}
.banner a{color:#ffd29e}
nav{display:flex;justify-content:space-between;align-items:center;padding:16px 0}
.brand{font-weight:800;font-size:20px;letter-spacing:-.3px}.brand span{color:var(--c)}
.btn{display:inline-block;background:var(--c);color:#fff;text-decoration:none;padding:12px 20px;border-radius:10px;font-weight:700;border:0;font-size:16px;cursor:pointer}
.btn.alt{background:#fff;color:var(--ink);border:2px solid var(--ink)}
.hero{background:linear-gradient(135deg,var(--c),var(--c2));color:#fff;border-radius:22px;padding:48px 32px;margin:8px 0 32px;position:relative;overflow:hidden}
.hero:after{content:"{{ icon }}";position:absolute;right:-10px;bottom:-30px;font-size:180px;opacity:.15}
.hero h1{font-size:clamp(30px,5vw,48px);line-height:1.1;margin:0 0 12px;letter-spacing:-1px}
.hero p{font-size:18px;max-width:560px;margin:0 0 22px;opacity:.95}
.hero .btn{background:#fff;color:var(--ink)}.hero .btn.alt{background:transparent;color:#fff;border-color:#fff}
.pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.pills span{background:rgba(255,255,255,.18);padding:5px 12px;border-radius:999px;font-size:14px}
section{padding:28px 0}h2{font-size:28px;margin:0 0 16px;letter-spacing:-.5px}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}
.card h3{margin:0 0 6px;font-size:18px}.card p{margin:0;color:var(--muted)}.card .p{font-weight:800;color:var(--c);margin-top:8px}
.rating{font-size:22px;font-weight:800}.stars{color:#f5a623;letter-spacing:2px}
.two{display:grid;gap:20px;grid-template-columns:1fr 1fr}
table{width:100%;border-collapse:collapse}td{padding:6px 0;border-bottom:1px solid var(--line)}td:last-child{text-align:right;font-weight:600}
iframe.map{width:100%;height:280px;border:0;border-radius:16px}
form{display:grid;gap:10px}input,textarea,select{font:inherit;padding:12px;border-radius:10px;border:1px solid #cfccc4;width:100%;background:#fff}
footer{color:var(--muted);font-size:14px;padding:28px 0;text-align:center}
.bar{position:fixed;left:0;right:0;bottom:0;display:flex;gap:8px;padding:10px;background:#fff;border-top:1px solid var(--line);z-index:9}
.bar a{flex:1;text-align:center}
@media(min-width:821px){.bar{display:none}body{padding-bottom:0}}
@media(max-width:820px){.two{grid-template-columns:1fr}.hero{padding:36px 22px}nav .btn{display:none}}
.bar .btn{padding:12px 8px;white-space:nowrap}
</style>
</head>
<body>
{% if banner %}<div class="banner">{{ banner|safe }}</div>{% endif %}
<div class="wrap">
<nav><div class="brand">{{ name_html|safe }}</div>{% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">Call {{ phone }}</a>{% endif %}</nav>

<div class="hero">
 <h1>{{ headline }}</h1>
 <p>{{ intro }}</p>
 {% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">{{ cta_primary }}</a>{% endif %}
 <a class="btn alt" href="#contact">{{ cta_secondary }}</a>
 {% if pills %}<div class="pills">{% for p in pills %}<span>{{ p }}</span>{% endfor %}</div>{% endif %}
</div>

<section id="services">
 <h2>{{ services_title }}</h2>
 <div class="grid">
 {% for s in services %}<div class="card"><h3>{{ s.name }}</h3>{% if s.desc %}<p>{{ s.desc }}</p>{% endif %}{% if s.price %}<div class="p">{{ s.price }}</div>{% endif %}</div>{% endfor %}
 </div>
</section>

{% if rating %}
<section id="reviews">
 <div class="card" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
  <div class="rating">{{ rating }} <span class="stars">★★★★★</span></div>
  <div style="color:var(--muted)">from {{ review_count }} Google reviews</div>
  {% if maps_url %}<a href="{{ maps_url }}" style="margin-left:auto">Read reviews →</a>{% endif %}
 </div>
</section>
{% endif %}

{% if about %}<section id="about"><h2>About us</h2><p style="font-size:17px;max-width:720px">{{ about }}</p></section>{% endif %}

<section id="visit">
 <div class="two">
  <div>
   <h2>{{ area_title }}</h2>
   {% if area %}<p>{{ area }}</p>{% endif %}
   {% if hours %}<table>{% for h in hours %}<tr><td>{{ h[0] }}</td><td>{{ h[1] }}</td></tr>{% endfor %}</table>{% endif %}
   {% if address %}<p style="margin-top:14px"><b>{{ address }}</b></p>{% endif %}
  </div>
  <div>{% if map_query %}<iframe class="map" loading="lazy" src="https://maps.google.com/maps?q={{ map_query|urlencode }}&output=embed" title="Map"></iframe>{% endif %}</div>
 </div>
</section>

<section id="contact">
 <h2>{{ contact_title }}</h2>
 <div class="two">
  <form data-email="{{ email }}" onsubmit="event.preventDefault();var f=this;location.href='mailto:'+f.dataset.email+'?subject='+encodeURIComponent('Enquiry from website')+'&body='+encodeURIComponent('Name: '+f.n.value+'\nPhone: '+f.p.value+'\n\n'+f.m.value);">
   <input name="n" placeholder="Your name" required>
   <input name="p" placeholder="Phone" required>
   <textarea name="m" rows="4" placeholder="{{ form_placeholder }}"></textarea>
   <button class="btn" type="submit">Send enquiry</button>
  </form>
  <div class="card">
   {% if phone %}<p><b>Phone:</b> <a href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a></p>{% endif %}
   {% if email %}<p><b>Email:</b> <a href="mailto:{{ email }}">{{ email }}</a></p>{% endif %}
   {% for l in links %}<p><a href="{{ l[1] }}">{{ l[0] }}</a></p>{% endfor %}
   {% if licence %}<p style="color:var(--muted)">{{ licence }}</p>{% endif %}
  </div>
 </div>
</section>
<footer>© {{ year }} {{ name }}{% if abn %} · ABN {{ abn }}{% endif %}{% if credit %} · Site by <a href="{{ credit }}">Kerbside Web</a>{% endif %}</footer>
</div>
<div class="bar">{% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">Call</a>{% endif %}<a class="btn alt" href="#contact">{{ bar_cta or cta_secondary }}</a></div>
</body></html>
