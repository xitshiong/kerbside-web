<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ name }}: {{ tagline }}</title>
<meta name="description" content="{{ intro }}">
<meta name="theme-color" content="{{ color }}">
<meta property="og:title" content="{{ name }}: {{ tagline }}">
<meta property="og:description" content="{{ intro }}">
<meta property="og:type" content="website">
{% if hero %}<meta property="og:image" content="img/{{ hero.id }}-1600.jpg">{% endif %}
{% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ font|replace(' ','+') }}:wght@{{ font_weights }}&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">
{% if hero %}<link rel="preload" as="image" href="img/{{ hero.id }}-1600.jpg" imagesrcset="img/{{ hero.id }}-800.jpg 800w, img/{{ hero.id }}-1600.jpg 1600w" imagesizes="{% if layout == "venue" %}100vw{% else %}(max-width: 820px) 100vw, 55vw{% endif %}">{% endif %}
<style>
/* Hallmark · v2.0.0 · redesign: polish · theme: custom per trade (spec font, colour, paper, radius) · job: call or enquire, action in hero and fixed bar · hero: photo beside headline · nav: wordmark, links, phone · footer: row with credits */
/* Hallmark · pre-emit critique · weakest: stand-in photos until the client sends their own */
:root{--on:#fffdf8;--field:#fffefb;--c:{{ color }};--c2:{{ accent }};--paper:{{ paper }};--ink:#17181c;--muted:#585c66;--line:color-mix(in srgb,var(--ink) 14%,transparent);--display:"{{ font }}",Georgia,serif;--r:{{ radius }};--ir:{{ img_radius }}}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;overflow-x:clip}
body{margin:0;font:400 17px/1.6 "DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--paper);padding-bottom:76px;overflow-x:clip;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-underline-offset:3px}
:focus-visible{outline:3px solid var(--c);outline-offset:3px;border-radius:4px}
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}
.banner{background:var(--ink);color:var(--on);font-size:14px;text-align:center;padding:8px 16px}
.banner a{color:var(--on);font-weight:700}
.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:var(--field);padding:8px 12px;z-index:20}
header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 0}
.brand{font-family:var(--display);font-weight:700;font-size:clamp(21px,2.4vw,26px);letter-spacing:-.01em;text-decoration:none;line-height:1.1}
.brand span{color:var(--c)}
header nav{display:flex;gap:24px;align-items:center;font-weight:500;font-size:15px}
header nav a:not(.btn){text-decoration:none}header nav a:not(.btn):hover{text-decoration:underline}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;background:var(--c);color:var(--on);text-decoration:none;padding:12px 24px;border-radius:var(--r);font:700 16px/1.2 inherit;font-family:inherit;border:2px solid var(--c);cursor:pointer;transition:transform .16s cubic-bezier(.2,.7,.2,1),background-color .16s ease,color .16s ease,border-color .16s ease}
.btn:hover{background:var(--c2);border-color:var(--c2)}.btn:active{transform:scale(.97)}.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--ink)}.btn.ghost:hover{background:var(--ink);color:var(--on)}
.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(24px,4vw,56px);align-items:center;padding:clamp(12px,3vw,40px) 0 clamp(40px,6vw,80px)}
.hero.solo{grid-template-columns:minmax(0,1fr)}
.kind{font-size:15px;font-weight:500;color:var(--muted);margin:20px 0 0}
h1,h2,h3{font-family:var(--display);font-weight:{{ heading_weight }};letter-spacing:-.02em;line-height:1.05;margin:0;overflow-wrap:break-word;min-width:0}
h1{font-size:clamp(40px,6.2vw,80px);margin-bottom:20px;text-wrap:balance}
.hero p.lead{font-size:clamp(18px,1.6vw,20px);color:var(--muted);max-width:34ch;margin:0 0 28px}
.ctas{display:flex;flex-wrap:wrap;gap:12px}
.hero figure{margin:0;border-radius:var(--ir);overflow:hidden;aspect-ratio:4/3.4;background:var(--line)}
.hero figure img{width:100%;height:100%;object-fit:cover}
.facts{display:flex;flex-wrap:wrap;gap:12px 28px;list-style:none;padding:24px 0;margin:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-weight:500}
.facts li{display:flex;align-items:center;gap:12px}.facts li:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--c)}
section{padding:clamp(48px,7vw,96px) 0}
h2{font-size:clamp(32px,4.2vw,52px);margin-bottom:28px;text-wrap:balance}
.split{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(24px,5vw,72px);align-items:start}
.list{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
.list li{display:grid;grid-template-columns:1fr auto;gap:4px 20px;padding:20px 0;border-bottom:1px solid var(--line)}
.list h3{font-size:clamp(20px,2vw,24px);font-weight:{{ heading_weight }}}
.list .price{font-weight:700;color:var(--c);white-space:nowrap;align-self:baseline;font-variant-numeric:tabular-nums}
.list p{grid-column:1/-1;margin:0;color:var(--muted);max-width:56ch}
.about{background:var(--c2);color:var(--on)}
.about .split{align-items:center}
.about p{font-size:clamp(19px,1.8vw,23px);line-height:1.5;margin:0;max-width:48ch}
.about figure{margin:0;border-radius:var(--ir);overflow:hidden;aspect-ratio:4/3}
.about figure img{width:100%;height:100%;object-fit:cover}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
td{padding:12px 0;border-bottom:1px solid var(--line)}td:last-child{text-align:right;font-weight:700}
.addr{margin:24px 0 0;font-weight:700}
.area{color:var(--muted);margin:0 0 20px}
iframe.map{width:100%;height:100%;min-height:340px;border:0;border-radius:var(--ir);filter:grayscale(.3)}
.contact{background:color-mix(in srgb,var(--c) 9%,var(--paper))}
form{display:grid;gap:16px}
label{display:grid;gap:8px;font-weight:700;font-size:15px}
input,textarea{font:inherit;font-weight:400;padding:12px 16px;border-radius:var(--r);border:1.5px solid color-mix(in srgb,var(--ink) 30%,transparent);width:100%;background:var(--field);color:var(--ink)}
input:focus,textarea:focus{outline:3px solid color-mix(in srgb,var(--c) 45%,transparent);border-color:var(--c)}
.direct{display:grid;gap:16px;align-content:start}
.direct a.big{font-family:var(--display);font-size:clamp(28px,3.4vw,40px);font-weight:{{ heading_weight }};text-decoration:none;color:var(--c);line-height:1.1}
.direct p{margin:0}.muted{color:var(--muted)}
footer{padding:32px 0 40px;font-size:14px;color:var(--muted)}
footer .row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px}
.credits{margin-top:16px;font-size:12px}.credits a{color:inherit}
.bar{position:fixed;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px 12px calc(12px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(10px);border-top:1px solid var(--line);z-index:9}
.vhead{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:24px}
.vhead nav{display:flex;gap:24px;font-weight:500;font-size:15px}.vhead nav a{text-decoration:none}.vhead nav a:hover{text-decoration:underline}
.vhead .brand{font-size:clamp(26px,3vw,38px);text-align:center}.vend{justify-self:end}
.vhero{position:relative;isolation:isolate;display:grid;align-items:end;min-height:min(74svh,720px);color:var(--on);background:var(--c2)}
.vhero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.vhero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,transparent 30%,color-mix(in srgb,var(--c2) 88%,transparent))}
.vhero.flat:after{display:none}
.vcopy{width:100%;padding-top:48px;padding-bottom:clamp(32px,5vw,64px)}
.vcopy h1{max-width:16ch;color:var(--on)}.vcopy .lead{color:var(--on);opacity:.92;max-width:44ch}
.vhero .btn.ghost{color:var(--on);border-color:var(--on)}.vhero .btn.ghost:hover{background:var(--on);color:var(--ink)}
.vinfo{list-style:none;margin:0;padding:24px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px clamp(24px,5vw,72px);border-bottom:1px solid var(--line)}
.vinfo li{display:grid;gap:4px;align-content:start}.vinfo b{font-family:var(--display);font-size:20px;font-weight:{{ heading_weight }}}
.vinfo span,.vinfo a{color:var(--muted)}.vinfo a{text-decoration:underline}
.venue #services .list{columns:2;column-gap:clamp(24px,5vw,72px);border-top:0}.venue #services .list li{break-inside:avoid;border-top:1px solid var(--line);border-bottom:0}
@media(min-width:821px){.bar{display:none}body{padding-bottom:0}}
@media(max-width:820px){
 .vhead{grid-template-columns:minmax(0,1fr) auto}.vhead nav{display:none}.vhead .brand{text-align:left}
 .vhero{min-height:72svh}.vinfo{grid-template-columns:minmax(0,1fr)}.venue #services .list{columns:1}
 header nav a:not(.btn){display:none}
 .hero,.split{grid-template-columns:minmax(0,1fr)}
 .hero figure{order:-1;margin:0 calc(-1*clamp(20px,4vw,40px));border-radius:0;aspect-ratio:4/3}
 iframe.map{min-height:280px}
}
@media(max-width:420px){header .btn{display:none}}
@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@keyframes settle{from{opacity:0;transform:scale(1.04)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:no-preference){
 .hero h1,.hero .lead,.hero .ctas,.hero .kind,.vcopy h1,.vcopy .lead,.vcopy .ctas{animation:rise .7s cubic-bezier(.2,.7,.2,1) both}
 .hero .lead,.vcopy .lead{animation-delay:.08s}.vcopy .ctas{animation-delay:.16s}.hero .ctas{animation-delay:.16s}.hero .kind{animation-delay:.24s}
 .vhero img,.hero figure img{animation:settle 1.1s cubic-bezier(.2,.7,.2,1) both}
 @supports(animation-timeline:view()){.list li,.about figure,.direct,form{animation:rise linear both;animation-timeline:view();animation-range:entry 0% entry 40%}}
 .list li{transition:transform .2s cubic-bezier(.2,.7,.2,1)}
 @media(hover:hover){.list li:hover{transform:translateX(4px)}}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
</style>
</head>
<body{% if layout %} class="{{ layout }}"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
{% if banner %}<div class="banner">{{ banner|safe }}</div>{% endif %}
{% if layout == "venue" %}
<div class="wrap">
<header class="vhead">
 <nav aria-label="Main">{% if services %}<a href="#services">{{ services_title }}</a>{% endif %}{% if about %}<a href="#about">About</a>{% endif %}<a href="#visit">{{ area_title }}</a></nav>
 <a class="brand" href="#top" aria-label="{{ name }} home">{{ name_html|safe }}</a>
 <div class="vend">{% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a>{% else %}<a class="btn" href="#contact">{{ bar_cta or "Enquire" }}</a>{% endif %}</div>
</header>
</div>
<main id="main">
<div id="top" class="vhero{% if not hero %} flat{% endif %}">
 {% if hero %}<img src="img/{{ hero.id }}-1600.jpg" srcset="img/{{ hero.id }}-800.jpg 800w, img/{{ hero.id }}-1600.jpg 1600w" sizes="100vw" width="{{ hero.w }}" height="{{ hero.h }}" alt="{{ hero.alt }}" fetchpriority="high" decoding="async">{% endif %}
 <div class="wrap vcopy">
  <h1>{{ headline }}</h1>
  <p class="lead">{{ intro }}</p>
  <div class="ctas">
   {% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">{{ cta_primary }}</a>{% endif %}
   <a class="btn ghost" href="#contact">{{ cta_secondary }}</a>
  </div>
 </div>
</div>
<div class="wrap">
 <ul class="vinfo" aria-label="Visit">
  <li><b>{{ tagline }}</b>{% if address %}<a href="#visit">{{ address }}</a>{% endif %}</li>
  {% if hours %}<li><b>Hours</b><span>{% for h in hours[:2] %}{{ h[0] }} {{ h[1] }}{% if not loop.last %}<br>{% endif %}{% endfor %}</span>{% if hours|length > 2 %}<a href="#visit">All opening hours</a>{% endif %}</li>{% endif %}
  {% if phone %}<li><b>Call</b><a href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a></li>{% elif email %}<li><b>Email</b><a href="mailto:{{ email }}">{{ email }}</a></li>{% endif %}
 </ul>
{% else %}
<div class="wrap">
<header>
 <a class="brand" href="#top" aria-label="{{ name }} home">{{ name_html|safe }}</a>
 <nav aria-label="Main">
  {% if services %}<a href="#services">{{ services_title }}</a>{% endif %}{% if about %}<a href="#about">About</a>{% endif %}<a href="#visit">{{ area_title }}</a>
  {% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a>{% endif %}
 </nav>
</header>
</div>
<main id="main">
<div class="wrap" id="top">
 <div class="hero{% if not hero %} solo{% endif %}">
  <div>
   <h1>{{ headline }}</h1>
   <p class="lead">{{ intro }}</p>
   <div class="ctas">
    {% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">{{ cta_primary }}</a>{% endif %}
    <a class="btn ghost" href="#contact">{{ cta_secondary }}</a>
   </div>
   <p class="kind">{{ tagline }}</p>
  </div>
  {% if hero %}<figure><img src="img/{{ hero.id }}-1600.jpg" srcset="img/{{ hero.id }}-800.jpg 800w, img/{{ hero.id }}-1600.jpg 1600w" sizes="(max-width: 820px) 100vw, 55vw" width="{{ hero.w }}" height="{{ hero.h }}" alt="{{ hero.alt }}" fetchpriority="high" decoding="async"></figure>{% endif %}
 </div>
{% endif %}
 {% if pills %}<ul class="facts" aria-label="At a glance">{% for p in pills %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}
</div>

{% if services %}<section id="services">
 <div class="wrap split">
  <div><h2>{{ services_title }}</h2>{% if services_note %}<p class="muted">{{ services_note }}</p>{% endif %}</div>
  <ul class="list">
  {% for s in services %}<li><h3>{{ s.name }}</h3>{% if s.price %}<span class="price">{{ s.price }}</span>{% endif %}{% if s.desc %}<p>{{ s.desc }}</p>{% endif %}</li>{% endfor %}
  </ul>
 </div>
</section>{% endif %}

{% if about %}
<section id="about" class="about">
 <div class="wrap split">
  {% if about_img %}<figure><img src="img/{{ about_img.id }}-800.jpg" srcset="img/{{ about_img.id }}-800.jpg 800w, img/{{ about_img.id }}-1600.jpg 1600w" sizes="(max-width: 820px) 100vw, 40vw" width="{{ about_img.w }}" height="{{ about_img.h }}" alt="{{ about_img.alt }}" loading="lazy" decoding="async"></figure>{% endif %}
  <div><h2>{{ about_title }}</h2><p>{{ about }}</p></div>
 </div>
</section>
{% endif %}

{% if rating and maps_url %}
<div class="wrap"><p class="facts" style="justify-content:center"><a href="{{ maps_url }}">Rated {{ rating }} from {{ review_count }} Google reviews →</a></p></div>
{% endif %}

<section id="visit">
 <div class="wrap split">
  <div>
   <h2>{{ area_title }}</h2>
   {% if area %}<p class="area">{{ area }}</p>{% endif %}
   {% if hours %}<table><caption class="skip">Opening hours</caption>{% for h in hours %}<tr><td>{{ h[0] }}</td><td>{{ h[1] }}</td></tr>{% endfor %}</table>{% endif %}
   {% if address %}<p class="addr">{{ address }}</p>{% endif %}
  </div>
  {% if map_query %}<iframe class="map" loading="lazy" src="https://maps.google.com/maps?q={{ map_query|urlencode }}&output=embed" title="Map of {{ map_query }}"></iframe>{% endif %}
 </div>
</section>

<section id="contact" class="contact">
 <div class="wrap split">
  <div class="direct">
   <h2>{{ contact_title }}</h2>
   {% if phone %}<a class="big" href="tel:{{ phone|replace(' ','') }}">{{ phone }}</a>{% endif %}
   {% if email %}<p><a href="mailto:{{ email }}">{{ email }}</a></p>{% endif %}
   {% for l in links %}<p><a href="{{ l[1] }}">{{ l[0] }}</a></p>{% endfor %}
   {% if licence %}<p class="muted">{{ licence }}</p>{% endif %}
  </div>
  <form data-email="{{ email }}" onsubmit="event.preventDefault();var f=this;location.href='mailto:'+f.dataset.email+'?subject='+encodeURIComponent('Enquiry from website')+'&body='+encodeURIComponent('Name: '+f.n.value+'\nPhone: '+f.p.value+'\n\n'+f.m.value);">
   <label>Your name<input name="n" autocomplete="name" required></label>
   <label>Phone<input name="p" type="tel" autocomplete="tel" inputmode="tel" required></label>
   <label>{{ form_label }}<textarea name="m" rows="4" placeholder="{{ form_placeholder }}"></textarea></label>
   <button class="btn" type="submit">Send enquiry</button>
  </form>
 </div>
</section>
</main>
<footer class="wrap">
 <div class="row"><span>© {{ year }} {{ name }}{% if abn %}, ABN {{ abn }}{% endif %}</span>{% if credit %}<span>Website by <a href="{{ credit }}">Kerbside Web</a></span>{% endif %}</div>
 {% if photo_credits %}<p class="credits">Photos: {% for p in photo_credits %}<a href="{{ p.page }}">{{ p.by }}</a> (<a href="{{ p.licenceUrl }}">{{ p.licence }}</a>){% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
</footer>
<div class="bar">{% if phone %}<a class="btn" href="tel:{{ phone|replace(' ','') }}">Call</a>{% endif %}<a class="btn ghost" href="#contact">{{ bar_cta or cta_secondary }}</a></div>
</body></html>
