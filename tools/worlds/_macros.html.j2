{% macro phone_icon() %}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>{% endmacro %}
{% macro pin_icon() %}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>{% endmacro %}
{% macro tel(phone) %}tel:{{ phone|replace(' ','') }}{% endmacro %}
{% macro maps(q) %}https://www.google.com/maps/search/?api=1&query={{ q|urlencode }}{% endmacro %}
{% macro form(email, form_label, form_placeholder, button="Send enquiry") %}
<form data-email="{{ email }}" onsubmit="event.preventDefault();var f=this;location.href='mailto:'+f.dataset.email+'?subject='+encodeURIComponent('Enquiry from website')+'&body='+encodeURIComponent('Name: '+f.n.value+'\nPhone: '+f.p.value+'\n\n'+f.m.value)">
 <label>Your name<input name="n" autocomplete="name" required></label>
 <label>Phone<input name="p" type="tel" autocomplete="tel" inputmode="tel" required></label>
 <label>{{ form_label }}<textarea name="m" rows="4" placeholder="{{ form_placeholder }}"></textarea></label>
 <button class="btn" type="submit">{{ button }}</button>
</form>
{% endmacro %}
{% macro photo(img, sizes, cls="") %}<img{% if cls %} class="{{ cls }}"{% endif %} src="img/{{ img.id }}-800.jpg" srcset="img/{{ img.id }}-800.jpg 800w, img/{{ img.id }}-1600.jpg 1600w" sizes="{{ sizes }}" width="{{ img.w }}" height="{{ img.h }}" alt="{{ img.alt }}"{% if img.pos %} style="object-position:{{ img.pos }}"{% endif %}>{% endmacro %}
