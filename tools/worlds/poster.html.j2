{% extends "worlds/_base.html.j2" %}
{% import "worlds/_macros.html.j2" as m %}
{# World: newsagent street poster. Each section is a wire-framed bill poster with a huge black headline stating a plain fact. tone=calm softens it for clinics and offices. #}
{% block theme %}#1b1b1b{% endblock %}
{% block fonts %}family=League+Gothic&family=Libre+Franklin:wght@400;600;800{% endblock %}
{% block bodyclass %}w-poster{% if tone == "calm" %} calm{% endif %}{% endblock %}
{% block css %}
:root{--mast:{{ poster_color or "#1a3aa8" }};--paper:#f6f5f0;--ink:#151515;--soft:#45443f;--wire:#262626;--ground:#cfccc3;--hot:#d62718;--head:"League Gothic",sans-serif;--ease:cubic-bezier(.16,1,.3,1);--hsize:clamp(64px,13vw,168px)}
.calm{--hot:var(--mast);--hsize:clamp(52px,9vw,116px)}
body{font:400 17px/1.6 "Libre Franklin",system-ui,sans-serif;color:var(--ink);background:var(--ground) radial-gradient(circle at 20% 30%,rgb(0 0 0/.05) 0 1px,#0000 1.5px) 0 0/9px 11px;caret-color:var(--mast)}
::selection{background:var(--ink);color:var(--paper)}
html{scrollbar-color:var(--wire) var(--ground)}
a{color:inherit;text-underline-offset:4px}
:focus-visible{outline:3px solid var(--mast);outline-offset:3px}
.banner{background:var(--ink);color:#e7e5de}.banner a{color:#fdfcf8}
.wrap{max-width:1120px;margin:0 auto;padding:0 clamp(14px,4vw,40px)}
.top{position:sticky;top:0;z-index:10;background:var(--paper);border-bottom:3px solid var(--ink)}
.top .wrap{display:flex;align-items:center;gap:24px;min-height:62px}
.brand{font:800 18px/1.1 "Libre Franklin",sans-serif;text-transform:uppercase;letter-spacing:.04em;text-decoration:none;margin-right:auto}
.top nav{display:flex;gap:22px;font-size:15px;font-weight:600}.top nav a{text-decoration:none}.top nav a:hover{text-decoration:underline}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:12px 24px;background:var(--ink);color:var(--paper);font:800 16px/1.2 "Libre Franklin",sans-serif;text-transform:uppercase;letter-spacing:.04em;text-decoration:none;border:0;border-radius:0;cursor:pointer;transition:background .2s,transform .2s var(--ease)}
.btn:hover{background:var(--mast)}.btn:active{transform:translateY(1px)}
.btn.alt{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 3px var(--ink)}
.btn.alt:hover{background:var(--ink);color:var(--paper)}
.top .btn{min-height:42px;padding:8px 16px;font-size:14px}
.frame{position:relative;margin:clamp(28px,5vw,56px) 0 0;padding:14px;background:linear-gradient(var(--wire),var(--wire)) 0 0/100% 3px no-repeat,linear-gradient(var(--wire),var(--wire)) 0 100%/100% 3px no-repeat,linear-gradient(var(--wire),var(--wire)) 0 0/3px 100% no-repeat,linear-gradient(var(--wire),var(--wire)) 100% 0/3px 100% no-repeat;box-shadow:0 26px 34px -26px rgb(0 0 0/.55)}
.frame::before,.frame::after{content:"";position:absolute;top:-10px;width:10px;height:10px;border:3px solid var(--wire);border-bottom:0;border-radius:6px 6px 0 0}
.frame::before{left:22%}.frame::after{right:22%}
.frame{display:flex;flex-direction:column}
.bill{flex:1;background:var(--paper);background-image:linear-gradient(rgb(0 0 0/.025),#0000 40%,rgb(0 0 0/.03));padding:0 0 clamp(24px,4vw,44px)}
.mast{display:flex;justify-content:space-between;align-items:center;gap:12px;background:var(--mast);color:#fdfcf8;padding:10px clamp(16px,3vw,28px);font:800 14px/1.2 "Libre Franklin",sans-serif;text-transform:uppercase;letter-spacing:.08em}
.mast .date{font-weight:600;letter-spacing:.04em;opacity:.92}
.bill .in{padding:0 clamp(16px,3vw,32px)}
.fact{font:400 var(--hsize)/.86 var(--head);text-transform:uppercase;letter-spacing:-.005em;margin:clamp(18px,3vw,30px) 0 0;color:var(--ink)}
.fact em{font-style:normal;color:var(--hot)}
.hero .fact{animation:set 1s var(--ease) both}
@keyframes set{from{letter-spacing:.04em}to{letter-spacing:-.005em}}
.sub{font:800 clamp(18px,2.2vw,24px)/1.25 "Libre Franklin",sans-serif;margin:18px 0 0;max-width:40ch}
.lead{max-width:60ch;margin:12px 0 0;color:var(--soft)}
.ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.today{margin:18px 0 0;font:800 14px/1.2 "Libre Franklin",sans-serif;text-transform:uppercase;letter-spacing:.08em}
.today:empty{display:none}
.row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 clamp(16px,3vw,32px)}
.list{list-style:none;margin:22px 0 0;padding:0;columns:2;column-gap:32px}
.list li{break-inside:avoid;padding:10px 0;border-top:2px solid var(--ink);font:800 19px/1.25 "Libre Franklin",sans-serif}
.list li span{float:right;font-weight:600;font-variant-numeric:tabular-nums}
.list li p{margin:4px 0 0;font:400 15px/1.5 "Libre Franklin",sans-serif;color:var(--soft)}
.hours{width:100%;margin-top:22px;font-size:18px}
.hours td{padding:10px 0;border-top:2px solid var(--ink)}
.hours td+td{text-align:right;font-weight:800}
.addr{display:flex;gap:10px;margin:20px 0 0;font-weight:600;font-size:18px}.addr .ico{margin-top:5px}
.map{flex:1;min-height:320px;border-top:3px solid var(--ink)}
.mapbill{padding:0;display:flex;flex-direction:column}
.big{display:block;font:400 clamp(56px,10vw,132px)/.9 var(--head);text-decoration:none;font-variant-numeric:tabular-nums;margin-top:18px}
.big:hover{color:var(--mast)}
.ways{list-style:none;padding:0;margin:18px 0 0;display:grid;gap:6px;font-weight:600}
form{display:grid;gap:16px;margin-top:22px}
form label{font:800 13px/1.2 "Libre Franklin",sans-serif;text-transform:uppercase;letter-spacing:.08em}
form input,form textarea{margin-top:6px;padding:12px 14px;background:#fdfcf8;border:2px solid var(--ink);border-radius:0;color:var(--ink)}
form input:focus,form textarea:focus{outline:none;box-shadow:0 0 0 3px var(--mast)}
form input::placeholder,form textarea::placeholder{color:#5f5d57}
form .btn{justify-self:start}
.calm .bill{background:#fbfbf8}.calm .fact{color:#1f2533}
.foot{max-width:1120px;margin:clamp(56px,8vw,88px) auto 0;padding:24px clamp(14px,4vw,40px) 32px;border-top:3px solid var(--ink);font-size:14px;color:#33322e}
.foot p{margin:0 0 6px;display:flex;flex-wrap:wrap;gap:6px 24px}.credits{font-size:13px}
.bar{background:var(--paper);border-top:3px solid var(--ink)}.bar .btn{min-height:52px;font-size:15px}
@media (max-width:820px){.row{grid-template-columns:minmax(0,1fr)}.list{columns:1}.top nav{display:none}.map{min-height:280px}}
@media (max-width:560px){.top .btn{display:none}.frame{padding:9px}}
{% endblock %}
{% block page %}
<div class="top"><div class="wrap">
 <a class="brand" href="#main">{{ name }}</a>
 <nav aria-label="Main">{% if services %}<a href="#services">{{ services_title }}</a>{% endif %}<a href="#visit">{{ area_title }}</a><a href="#contact">Contact</a></nav>
 {% if phone %}<a class="btn" href="{{ m.tel(phone) }}">{{ m.phone_icon() }}{{ phone }}</a>{% endif %}
</div></div>
<main id="main" class="wrap">
<div class="frame hero"><div class="bill">
 <div class="mast"><span>{{ name }}</span><span class="date">{{ tagline }}</span></div>
 <div class="in">
  <h1 class="fact">{{ headline }}</h1>
  <p class="today" data-hours='{{ hours|tojson }}'></p>
  <p class="lead">{{ intro }}</p>
  <div class="ctas">{% if phone %}<a class="btn" href="{{ m.tel(phone) }}">{{ m.phone_icon() }}{{ cta_primary }}</a>{% endif %}<a class="btn alt" href="#contact">{{ cta_secondary }}</a></div>
 </div>
</div></div>

{% if services %}<section id="services" class="frame"><div class="bill">
 <div class="mast"><span>{{ name }}</span><span class="date">{{ services_title }}</span></div>
 <div class="in">
  <h2 class="fact">{% if services|length <= 3 %}{% for s in services %}{{ s.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}{{ services_title }}{% endif %}</h2>
  {% if services|length > 3 or services[0].desc or services[0].price %}<ul class="list">{% for s in services %}<li>{{ s.name }}{% if s.price %}<span>{{ s.price }}</span>{% endif %}{% if s.desc %}<p>{{ s.desc }}</p>{% endif %}</li>{% endfor %}</ul>{% endif %}
  {% if services_note %}<p class="lead">{{ services_note }}</p>{% endif %}
 </div>
</div></section>{% endif %}

{% if about %}<section id="about" class="frame"><div class="bill"><div class="mast"><span>{{ name }}</span><span class="date">{{ about_title }}</span></div><div class="in"><p class="sub">{{ about }}</p></div></div></section>{% endif %}

<section id="visit" class="row">
 <div class="frame"><div class="bill">
  <div class="mast"><span>{{ name }}</span><span class="date">{{ area_title }}</span></div>
  <div class="in">
   <h2 class="fact">{% if hours %}Open {{ hours[0][0] }}{% elif address %}{{ address.split(',')[-1] }}{% else %}{{ area_title }}{% endif %}</h2>
   {% if hours %}<table class="hours"><caption class="sr">Opening hours</caption>{% for h in hours %}<tr><td>{{ h[0] }}</td><td>{{ h[1] }}</td></tr>{% endfor %}</table>{% endif %}
   {% if area %}<p class="lead">{{ area }}</p>{% endif %}
   {% if address %}<p class="addr">{{ m.pin_icon() }}<span>{{ address }} · <a href="{{ m.maps(map_query) }}">Directions</a></span></p>{% elif map_query %}<p class="addr">{{ m.pin_icon() }}<span><a href="{{ m.maps(map_query) }}">Directions</a></span></p>{% endif %}
  </div>
 </div></div>
 {% if map_query %}<div class="frame"><div class="bill mapbill"><div class="mast"><span>Map</span><span class="date">{{ address or map_query }}</span></div><iframe class="map" loading="lazy" src="https://maps.google.com/maps?q={{ map_query|urlencode }}&output=embed" title="Map of {{ map_query }}"></iframe></div></div>{% endif %}
</section>

<section id="contact" class="row">
 <div class="frame"><div class="bill">
  <div class="mast"><span>{{ name }}</span><span class="date">{{ contact_title }}</span></div>
  <div class="in">
   {% if phone %}<h2 class="fact">Call</h2><a class="big" href="{{ m.tel(phone) }}">{{ phone }}</a>{% else %}<h2 class="fact">Write in</h2>{% endif %}
   <ul class="ways">{% if email %}<li><a href="mailto:{{ email }}">{{ email }}</a></li>{% endif %}{% for l in links %}<li><a href="{{ l[1] }}">{{ l[0] }}</a></li>{% endfor %}</ul>
  </div>
 </div></div>
 <div class="frame"><div class="bill"><div class="mast"><span>Enquiry</span></div><div class="in">{{ m.form(email, form_label, form_placeholder) }}</div></div></div>
</section>
</main>
<script>
(function(){var el=document.querySelector('.today');if(!el)return;var rows=JSON.parse(el.dataset.hours||'[]');var D=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'],t=new Date().getDay();
function has(spec){return spec.split(',').some(function(p){p=p.trim();var r=p.split(' to ');var a=D.indexOf(r[0].slice(0,3)),b=D.indexOf((r[1]||r[0]).slice(0,3));if(a<0||b<0)return false;for(var i=a,n=0;n<8;i=(i+1)%7,n++){if(i===t)return true;if(i===b)break}return false})}
for(var i=0;i<rows.length;i++){if(has(rows[i][0])){var v=rows[i][1];el.textContent=/closed/i.test(v)?'Closed today':'Today: '+v;return}}})();
</script>
{% endblock %}
